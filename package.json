{
  "name": "code-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-language code intelligence: index repos into one symbol graph and ask about it.",
  "type": "module",
  "bin": {
    "code-atlas": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
